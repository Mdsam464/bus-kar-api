# Application Settings
APP_NAME="Transit AI Agent API & MCP Plugin"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (Defaults to async SQLite for instant local dev)
DATABASE_URL="sqlite+aiosqlite:///./transit.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/transit_db"

# Delhi Open Transit Data (OTD) Portal Credentials
# Register at https://otd.delhi.gov.in/ to get an API key
DELHI_OTD_API_KEY="YOUR_DELHI_OTD_API_KEY_HERE"
DELHI_OTD_BASE_URL="https://otd.delhi.gov.in/api/realtime"

# Redis Cache (Optional for dev, required for high-throughput live telemetry)
REDIS_URL="redis://localhost:6379/0"
