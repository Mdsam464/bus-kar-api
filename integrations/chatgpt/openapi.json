  "paths": {
    "/api/v1/transit/stops/resolve": {
      "get": {
        "tags": [
          "Transit Operations"
        ],
        "summary": "Resolve Stop",
        "operationId": "resolveStop",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Colloquial stop name, landmark, or street",
              "title": "Query"
            },
            "description": "Colloquial stop name, landmark, or street"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Transit city",
              "default": "delhi",
              "title": "City"
            },
            "description": "Transit city"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 3,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveStopResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
